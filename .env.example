# Copy to .env.local for local overrides. On Vercel, set these in
# Project Settings → Environment Variables instead.

# Canonical origin used for metadata, sitemap and structured data.
# Defaults to https://$VERCEL_PROJECT_PRODUCTION_URL on Vercel, http://localhost:3000 locally.
# NEXT_PUBLIC_SITE_URL=https://www.example.com

# Search engine indexing. Leave unset (off) everywhere except Production,
# and only turn on once business details are confirmed.
# SITE_INDEXING=true
